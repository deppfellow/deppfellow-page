---
import "../styles/global.css";
import { SITE_DESCRIPTION } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  search?: boolean;
}

const { title, description = SITE_DESCRIPTION, search = false } = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        const root = document.documentElement;
        let stored;
        try {
          stored = localStorage.getItem("deppfellow-theme");
        } catch {
          stored = null;
        }
        const system = matchMedia("(prefers-color-scheme: light)");
        if (stored === "light" || (stored !== "dark" && system.matches)) {
          root.setAttribute("data-theme", "light");
        } else {
          root.removeAttribute("data-theme");
        }
        root.setAttribute("data-enhanced", "");
        if (stored !== "light" && stored !== "dark") {
          system.addEventListener("change", function (event) {
            let current;
            try {
              current = localStorage.getItem("deppfellow-theme");
            } catch {
              current = null;
            }
            if (current === "light" || current === "dark") return;
            if (event.matches) root.setAttribute("data-theme", "light");
            else root.removeAttribute("data-theme");
          });
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {search && (
      <>
        <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
        <script
          is:inline
          src="/pagefind/pagefind-component-ui.js"
          type="module"
        ></script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
