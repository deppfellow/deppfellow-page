---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import RuleBand from "../components/RuleBand.astro";
import { readRegistry, vaultRoot } from "../lib/vault";

const categories = await readRegistry(vaultRoot());
const notes = await getCollection("notes");

const links = categories.map((category) => ({
  label: category,
  href: `/${category.toLowerCase()}/`,
  count: notes.filter((note) => note.data.category === category).length,
}));

// Mustache template consumed by Pagefind's <pagefind-results>; mustaches are
// template syntax, never Astro expressions, so it travels as a raw string.
const resultTemplate = `
<li class="search-result">
  <p class="search-result-title">
    <a class="search-result-link" href="{{ meta.url | default(url) | safeUrl }}">{{ meta.title | default("Untitled") }}</a>
  </p>
  {{#if excerpt}}
  <p class="search-result-excerpt">{{+ excerpt +}}</p>
  {{/if}}
  {{#if sub_results}}
  <ul class="search-sub-results">
    {{#each sub_results as sub}}
    <li class="search-sub-result">
      <a class="search-sub-link" href="{{ sub.url | safeUrl }}">{{ sub.title }}</a>
      {{#if sub.excerpt}}
      <p class="search-sub-excerpt">{{+ sub.excerpt +}}</p>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{/if}}
</li>
`;
---

<Base title="Search">
  <RuleBand name="deppfellow" links={links} />

  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script
      is:inline
      src="/pagefind/pagefind-component-ui.js"
      type="module"
    ></script>
  </Fragment>

  <main class="mx-auto w-full max-w-275 px-6 sm:px-10">
    <section class="pb-24 sm:pb-32" aria-labelledby="search-heading">
      <div class="mb-6 flex items-baseline justify-between gap-6 border-t border-rule pt-10">
        <h1 id="search-heading" class="label text-star">
          Search
        </h1>
        <span class="label text-star/70">All notes</span>
      </div>

      <div class="search-scope">
        <pagefind-input></pagefind-input>
        <pagefind-summary default-message="Type to search every published note."></pagefind-summary>
        <pagefind-results>
          <script
            is:inline
            type="text/pagefind-template"
            set:html={resultTemplate}
          ></script>
        </pagefind-results>
      </div>
    </section>
  </main>
</Base>

<style>
  .search-scope {
    /* Pagefind components isolate themselves with all:initial, so the plate
       system reaches them only through the --pf-* custom properties below. */
    --pf-text: var(--color-bone);
    --pf-text-secondary: var(--color-star);
    --pf-text-muted: var(--color-star);
    --pf-background: var(--color-plate);
    --pf-border: var(--color-rule);
    --pf-border-focus: var(--color-iris);
    --pf-skeleton: var(--color-plate-edge);
    --pf-skeleton-shine: var(--color-rule);
    --pf-hover: var(--color-plate-edge);
    --pf-mark: #ffffff;
    --pf-scroll-shadow: transparent;
    --pf-shadow-sm: none;
    --pf-shadow-md: none;
    --pf-shadow-lg: none;
    --pf-error-bg: var(--color-plate);
    --pf-error-border: var(--color-rule);
    --pf-error-text: var(--color-bone);
    --pf-error-text-secondary: var(--color-star);
    --pf-outline-focus: var(--color-iris);
    --pf-outline-width: 1px;
    --pf-outline-offset: 3px;
    --pf-font: var(--font-serif);
    --pf-border-radius: 0;
    --pf-input-height: 2.75rem;
    --pf-input-font-size: 1rem;
    --pf-summary-font-size: 0.875rem;
    --pf-results-gap: 0;
  }

  .search-scope :global(pagefind-input) {
    display: block;
  }

  .search-scope :global(pagefind-summary) {
    display: block;
    margin-top: 0.75rem;
    min-height: 1.375rem;
    color: var(--color-star);
  }

  .search-scope :global(pagefind-results) {
    display: block;
    margin-top: 1.25rem;
  }

  .search-scope :global(.search-result + .search-result) {
    border-top: 1px solid var(--color-rule);
  }

  .search-scope :global(.search-result) {
    padding-block: 1.25rem;
  }

  .search-scope :global(.search-result-title) {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 600;
  }

  .search-scope :global(.search-result-link) {
    color: var(--color-bone);
    text-decoration: none;
    transition: color 120ms steps(2, end);
  }

  .search-scope :global(.search-result-link:hover) {
    color: var(--color-iris);
  }

  .search-scope :global(.search-result-excerpt) {
    margin: 0.375rem 0 0;
    color: var(--color-bone);
  }

  .search-scope :global(mark) {
    background-color: color-mix(
      in oklab,
      var(--color-iris) 55%,
      var(--color-plate)
    );
    color: #ffffff;
  }

  .search-scope :global(.search-sub-results) {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .search-scope :global(.search-sub-result + .search-sub-result) {
    margin-top: 0.75rem;
  }

  .search-scope :global(.search-sub-link) {
    font-family: var(--font-label);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--color-star);
    text-decoration: none;
    transition: color 120ms steps(2, end);
  }

  .search-scope :global(.search-sub-link:hover) {
    color: var(--color-iris);
  }

  .search-scope :global(.search-sub-excerpt) {
    margin: 0.25rem 0 0;
    font-size: 1rem;
    color: var(--color-star);
  }

  @media (prefers-reduced-motion: reduce) {
    .search-scope :global(.search-result-link),
    .search-scope :global(.search-sub-link) {
      transition: none;
    }
  }
</style>
