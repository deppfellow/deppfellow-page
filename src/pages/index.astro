---
import { getCollection, render } from "astro:content";
import "../styles/global.css";

const about = (await getCollection("meta"))[0];
const notes = await getCollection("notes");
const AboutBody = about ? (await render(about)).Content : null;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>deppfellow-page</title>
  </head>
  <body class="bg-white font-sans text-neutral-900">
    <main class="mx-auto max-w-prose p-8">
      <h1 class="text-2xl font-semibold">deppfellow</h1>

      {AboutBody ? <AboutBody /> : null }
      <p class="mt-2">{notes.length} notes loaded</p>
    </main>
  </body>
</html>
