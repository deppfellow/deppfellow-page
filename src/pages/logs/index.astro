---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import RuleBand from "../../components/RuleBand.astro";
import LogRow from "../../components/LogRow.astro";
import { readRegistry, vaultRoot } from "../../lib/vault";

const categories = await readRegistry(vaultRoot());
const notes = await getCollection("notes");

const links = categories.map((category) => ({
  label: category,
  href: `/${category.toLowerCase()}/`,
  count: notes.filter((note) => note.data.category === category).length,
}));

const logs = notes
  .filter((note) => note.data.category === "Logs")
  .sort(
    (a, b) =>
      b.data.created.getTime() - a.data.created.getTime() ||
      a.data.slug.localeCompare(b.data.slug),
  );
---

<Base title="Logs">
  <RuleBand name="deppfellow" links={links} />

  <main class="measure mx-auto w-full px-6">
    <section class="pb-24 sm:pb-32" aria-labelledby="logs-index">
      <div class="mb-6 flex items-baseline justify-between gap-6 border-t border-rule pt-10">
        <h1 id="logs-index" class="label text-star">
          Logs
        </h1>
        <span class="label text-star/70">Newest first</span>
      </div>

      {logs.length > 0 ? (
        <ol>
          {logs.map((note) => (
            <LogRow note={note} />
          ))}
        </ol>
      ) : (
        <p class="text-bone">No logs published yet.</p>
      )}
    </section>
  </main>
</Base>
