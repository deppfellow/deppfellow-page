---
interface Link {
  label: string;
  href: string;
  count: number;
}

interface Props {
  name: string;
  links: Link[];
  search?: boolean;
}

const { name, links, search = false } = Astro.props;

// Mustache template consumed by Pagefind's <pagefind-results>; mustaches are
// template syntax, never Astro expressions, so it travels as a raw string.
// Result rows use the plate-row vocabulary: tabular date column, serif title.
const resultTemplate = `
<li class="result-item">
  <a class="rule-row" href="{{ meta.url | default(url) | safeUrl }}">
    <span class="rule-row-date">{{ meta.date }}</span>
    <span class="rule-row-title">{{ meta.title | default("Untitled") }}</span>
    <span class="rule-row-excerpt">{{+ excerpt +}}</span>
  </a>
</li>
`;
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-275 flex-wrap items-baseline justify-between gap-x-10 gap-y-3 px-6 py-5 sm:px-10">
    <a href="/" class="label text-name tracking-[0.22em] text-bone">
      {name}
    </a>
    <nav aria-label="Categories" class="flex items-center gap-6">
    {links.map((link) => (
        <a
          href={link.href}
          class="label inline-flex items-baseline text-star transition-colors hover:text-iris"
        >
          {link.label}
          <span class="ml-1.5 text-star/70">
            {String(link.count).padStart(2, "0")}
          </span>
        </a>
      ))}
      {search && (
        <pagefind-modal-trigger
          instance="pf-modal"
          placeholder="Search"
          compact="true"
          hide-shortcut
        />
      )}
    </nav>
  </div>
  {search && (
    <pagefind-modal instance="pf-modal">
      <pagefind-modal-header>
        <pagefind-input
          instance="pf-modal"
          placeholder="Search articles or projects"
        />
      </pagefind-modal-header>
      <pagefind-modal-body>
        <pagefind-summary instance="pf-modal" />
        <pagefind-results instance="pf-modal">
          <script
            is:inline
            type="text/pagefind-template"
            set:html={resultTemplate}
          ></script>
        </pagefind-results>
      </pagefind-modal-body>
      <pagefind-config instance="pf-modal" excerpt-length="60" hidden></pagefind-config>
    </pagefind-modal>
  )}
  {search && <script is:inline type="module">
    const pagefind = window.PagefindComponents;
    if (pagefind) {
      const manager = pagefind.getInstanceManager();
      // Compound "any" filter: an array alone defaults to AND semantics,
      // which no single page can satisfy across two type values.
      manager.getInstance("pf-modal").searchFilters = {
        type: { any: ["article", "project"] },
      };
      manager.getInstance("pf-logs").searchFilters = { type: ["log"] };
    }
  </script>}
</header>
